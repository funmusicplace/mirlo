PORT=8080

# Only needed when the API runs on a different origin from the client, as in
# local dev. Leave it unset when the API serves the built client.
VITE_API_DOMAIN=http://localhost:3000

VITE_CLOUDFLARE_CLIENT_KEY=1x00000000000000000000AA

# Umami analytics — leave unset in dev so no events are recorded.
# In production this is set at build time (Render env vars on the api
# service, since that's what builds the client).
# VITE_UMAMI_WEBSITE_ID=
# VITE_UMAMI_SRC=https://stats.mirlo.space/script.js


# Transifex token. If you set this you'll see live translations.
# VITE_TRANSIFEX_TOKEN=1/b110f591e1259b282a4aed8112cd243dbe0487e8
