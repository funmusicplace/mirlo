{
  "compilerOptions": {
    "module": "nodenext",
    "sourceMap": true,
    "outDir": "dist",
    "strict": true,
    "lib": ["esnext"],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "moduleResolution": "nodenext",
    "isolatedModules": true
  },
  "exclude": ["client", "prisma/dist"],
  "ts-node": {
    "transpileOnly": true
  }
}
