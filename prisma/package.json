{
  "name": "@mirlo/prisma",
  "main": "./prisma.ts",
  "type": "commonjs",
  "exports": {
    ".": {
      "mirlo-dist": "./dist/prisma.js",
      "import": "./prisma.ts",
      "require": "./prisma.ts",
      "types": "./prisma.ts",
      "default": "./prisma.ts"
    },
    "./client": {
      "mirlo-dist": "./dist/__generated__/client.js",
      "import": "./__generated__/client.ts",
      "require": "./__generated__/client.ts",
      "types": "./__generated__/client.ts",
      "default": "./__generated__/client.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prisma:build": "pnpify prisma generate",
    "prisma:format": "pnpify prisma format",
    "prisma:migrate": "DEBUG=prisma:client pnpify prisma migrate dev && pnpify prisma generate",
    "prisma:migrate:reset": "DEBUG=prisma:client pnpify prisma migrate reset",
    "prisma:migrate:deploy": "DEBUG=prisma:client pnpify prisma migrate deploy",
    "prisma:seed": "pnpify prisma db seed"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "^16.0.3"
  },
  "devDependencies": {
    "@types/node": "22",
    "@yarnpkg/pnpify": "^4.0.1",
    "prisma": "7.10.0",
    "prisma-json-types-generator": "4.1.1",
    "ts-node": "^10.9.2",
    "typescript": "5.9.3"
  }
}
