extends ../layout.pug
include ../mixins.pug

block content
  +greeting(user && user.name)
  - const inviterName = invitedBy && invitedBy.name
  - const artistName = artist && artist.name
  if inviterName && artistName
    p!= tHtml("emails.announceManagerInvite.invited", { inviterName, artistName })
  else if inviterName
    p!= tHtml("emails.announceManagerInvite.invitedUnnamedArtist", { inviterName })
  else if artistName
    p!= tHtml("emails.announceManagerInvite.invitedBySomeone", { artistName })
  else
    p!= tHtml("emails.announceManagerInvite.invitedBySomeoneUnnamedArtist")
  p= t("emails.announceManagerInvite.permissions")
  p 
    a(href!=`${client}/manage`)= t("emails.announceManagerInvite.review")
  p= t("emails.announceManagerInvite.ignore")
