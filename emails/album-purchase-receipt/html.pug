extends ../layout.pug
include ../mixins.pug

block content
    p= t("emails.albumPurchaseReceipt.wow")
    if isBeforeReleaseDate
      p= t("emails.albumPurchaseReceipt.thanksPreOrder", { artistName: trackGroup.artist.name, title: trackGroup.title })
    else
      p= t("emails.albumPurchaseReceipt.thanksPurchase", { artistName: trackGroup.artist.name, title: trackGroup.title })
     
    div
      p
        +releaseLink(trackGroup) #{trackGroup.title}
      p #{formatMoney(purchase.transaction.amount, purchase.transaction.currency)}
    if isBeforeReleaseDate
      p= t("emails.albumPurchaseReceipt.availableOnRelease")
    else 
      p= t("emails.albumPurchaseReceipt.availableNow")
    +artistMessage(trackGroup.artist, "purchase")
      p= t("emails.common.enjoy")
