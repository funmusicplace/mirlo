extends ../layout-wide.pug
include ../mixins.pug

block content
  p= t("emails.artistNewSubscriberAnnounce.wow")
  if isNewSubscription
    p= t("emails.artistNewSubscriberAnnounce.startedSupporting", { email: user.email, name: user.name || t("emails.common.aSupporter"), instanceName })
  else
    p= t("emails.artistNewSubscriberAnnounce.isSupporting", { email: user.email, name: user.name || t("emails.common.aSupporter"), instanceName })
  if interval === 'MONTH'
    p= t("emails.artistNewSubscriberAnnounce.supportMonthly", { artistName: artist.name, instanceName, tierName: artistUserSubscription.artistSubscriptionTier.name })
  else
    p= t("emails.artistNewSubscriberAnnounce.supportYearly", { artistName: artist.name, instanceName, tierName: artistUserSubscription.artistSubscriptionTier.name })
  if transaction
    table
      thead
        tr
          th.num= t("emails.artistNewSubscriberAnnounce.grossAmount")
          th.num= t("emails.artistNewSubscriberAnnounce.platformFee")
          th.num= t("emails.artistNewSubscriberAnnounce.paymentProcessorFee")
          th.num= t("emails.artistNewSubscriberAnnounce.netAmount")
      tbody
        tr
          +feeCells(transaction, { currency: transaction.currency, net: true })
  p= t("emails.artistNewSubscriberAnnounce.viewSupporters", { instanceName })
  p= t("emails.common.enjoy")
