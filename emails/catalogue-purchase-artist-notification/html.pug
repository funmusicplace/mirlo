extends ../layout.pug

block content
  p= t("emails.cataloguePurchaseArtistNotification.hello", { artistName: artist.name })
  p= t("emails.cataloguePurchaseArtistNotification.boughtCatalogue", { email })
  p= t("emails.cataloguePurchaseArtistNotification.amountPaid", { amount: formatMoney(pricePaid, currencyPaid), instanceName, platformCut: formatMoney(platformCut, currencyPaid) })
    
  p= t("emails.cataloguePurchaseArtistNotification.stripeDashboard")
  p!= tHtml("emails.cataloguePurchaseArtistNotification.learnAboutPayouts", { url: "https://docs.mirlo.space/payouts" })
  if contactEmail
    p= t("emails.cataloguePurchaseArtistNotification.questions", { contactEmail })

