extends ../layout.pug
include ../mixins.pug

block content
  p!= tHtml("emails.albumDownload.intro", { title: trackGroup.title, artistName: trackGroup.artist.name })
  table 
    tr 
      td #{trackGroup.title}
      td 
        +releaseLink(trackGroup, `/download?token=${token}&email=${encodeURIComponent(email)}`)= t("emails.albumDownload.download")

  p
  +supportArtist(trackGroup.artist, client, hasSubscriptionTiers)
  +setPasswordPrompt(email)
  +artistMessage(trackGroup.artist, "purchase")
    p= t("emails.common.enjoy")
