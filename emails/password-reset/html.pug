extends ../layout.pug
include ../mixins.pug

block content
    +greeting()
    if accountIncomplete
      p= t("emails.passwordReset.setPassword")
    else 
      p= t("emails.passwordReset.resetPassword")

    p #{user.email}
    p 
      a(href!=`${host}/auth/password-reset/confirmation/${token}?id=${user.id}&redirectClient=${redirectClient}&accountIncomplete=${accountIncomplete}`)= t("emails.passwordReset.confirm")
    p= t("emails.common.ignore")
