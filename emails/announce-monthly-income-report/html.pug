extends ../layout-wide.pug
include ../mixins.pug

block content
  p Hi #{user.name}
  p Here's your report for the past month.

  table
    tbody
      tr
        th Sales (#{sales.length})
        td.num
          +currency(salesTotal, currency)
      tr
        th Subscription payments (#{subscriptionPayments.length})
        td.num
          +currency(subscriptionTotal, currency)
      tr
        th Total income
        td.num
          strong
            +currency(totalIncome, currency)
      if cancelledSubscriptions.length
        tr
          th Cancelled subscriptions
          td.num #{cancelledSubscriptions.length}

  if sales.length
    h2 Sales
    table
      thead
        tr
          th Artist
          th Date
          th Type
          th Title
          th Buyer
          th.num Amount
      tbody
        each sale in sales
          tr
            td #{sale.artist.map(a => a.name).join(', ')}
            td #{sale.datePurchased.split('T')[0]}
            td #{sale.saleTypeLabel}
            td #{sale.saleTypeLabel === 'Tip' ? '' : sale.title}
            td #{sale.user.name} (#{sale.user.email})
            td.num
              +currency(sale.amount, currency)
    p
      | Sales income: 
      +currency(salesTotal, currency)

  if subscriptionPayments.length
    h2 Subscription payments
    table
      thead
        tr
          th Date
          th Supporter
          th Tier
          th Interval
          th.num Amount
      tbody
        each sale in subscriptionPayments
          - const tier = sale.artistUserSubscriptionCharges[0].artistUserSubscription.artistSubscriptionTier
          tr
            td #{sale.datePurchased.split('T')[0]}
            td #{sale.user.name}
            td #{tier.name}
            td #{tier.interval === 'YEAR' ? 'Yearly' : 'Monthly'}
            td.num
              +currency(sale.amount, currency)
    p
      | Subscription income: 
      +currency(subscriptionTotal, currency)

  if cancelledSubscriptions.length
    h2 Cancelled subscriptions
    table
      thead
        tr
          th Supporter
          th Tier
          th Reason
          th.num Amount no longer recurring
      tbody
        each cancelled in cancelledSubscriptions
          tr
            td #{cancelled.user.name || 'A supporter'}
            td #{cancelled.artistSubscriptionTier.name}
            td #{cancelled.deleteReasonLabel}
            td.num
              +currency(cancelled.amount, currency)

  if totalIncome > 0
    p We love to see it. Enjoy!
