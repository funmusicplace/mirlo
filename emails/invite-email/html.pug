extends ../layout.pug

block content

    h2.mw600= t("emails.inviteEmail.title")
    p.mw600= t("emails.inviteEmail.invitedBy", { name: invitedBy.name, email: invitedBy.email })
    p.mw600
      a(href!=`${client}/signup/?inviteToken=${token}&email=${encodeURIComponent(email)}&accountType=${accountType.toLowerCase()}&invitedBy=${encodeURIComponent(invitedBy.name)}`)= t("emails.inviteEmail.claim")

    p.mw600= t("emails.inviteEmail.ignore")


