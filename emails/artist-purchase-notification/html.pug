extends ../layout-wide.pug
include ../mixins.pug

mixin purchaseRow(title, sku, transaction, trackGroup)
  tr
    td #{transaction.userFriendlyId || '---'}
    td
      if trackGroup
        +releaseLink(trackGroup) #{title}
      else
        | #{title}
    td #{sku}
    +feeCells(transaction, { net: true })

block content
  p= t("emails.artistPurchaseNotification.intro", { instanceName })
  p= t("emails.artistPurchaseNotification.purchasedBy", { email })

  table
    thead
      tr
        th= t("emails.artistPurchaseNotification.transactionId")
        th= t("emails.artistPurchaseNotification.item")
        th= t("emails.artistPurchaseNotification.sku")
        th.num= t("emails.artistPurchaseNotification.gross", { currency: currency.toUpperCase() })
        th.num= t("emails.artistPurchaseNotification.platformFee")
        th.num= t("emails.artistPurchaseNotification.paymentProcessorFee")
        th.num= t("emails.artistPurchaseNotification.net", { currency: currency.toUpperCase() })
    tbody
      each transaction in transactions
        if transaction.trackGroupPurchases
          each purchase in transaction.trackGroupPurchases
            if !purchase.proGratis
              +purchaseRow(t("emails.artistPurchaseNotification.digitalItem", { artistName: purchase.trackGroup.artist.name, title: purchase.trackGroup.title }),
                 purchase.trackGroup.catalogNumber,
                 transaction,
                 purchase.trackGroup)
        if transaction.trackPurchases
          each purchase in transaction.trackPurchases
            +purchaseRow(t("emails.artistPurchaseNotification.digitalItem", { artistName: purchase.track.trackGroup.artist.name, title: purchase.track.title }),
              purchase.track.isrc,
              transaction)
        if transaction.merchPurchases
          each purchase in transaction.merchPurchases
            +purchaseRow(t("emails.artistPurchaseNotification.merchItem", { artistName: purchase.merch.artist.name, title: purchase.merch.title }),
              purchase.merch.sku,
              transaction)
        if transaction.tips
          each tip in transaction.tips
            +purchaseRow(t("emails.artistPurchaseNotification.tip"), '', transaction)
      tr.totals
        td(colspan="3")= t("emails.artistPurchaseNotification.total")
        td.num #{formatAmount(totalGross)}
        td.num
        td.num
        td.num #{formatAmount(totalNet)}


  p!= tHtml("emails.artistPurchaseNotification.viewSales", { url: `${client}/sales` })
  p!= tHtml("emails.artistPurchaseNotification.learnAboutPayouts", { url: "https://docs.mirlo.space/payouts" })
