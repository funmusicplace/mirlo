extends ../layout.pug
include ../mixins.pug

block content
  +greeting()
  p= t("emails.confirmEmailChange.intro", { instanceName })
  p 
    strong #{newEmail}
  p 
    a(href!=`${clientDomain}/confirm-email-change?token=${token}&userId=${userId}`)= t("emails.confirmEmailChange.confirm")
  p= t("emails.confirmEmailChange.ignore")
  if contactEmail
    p= t("emails.confirmEmailChange.contactUs", { contactEmail })
