extends ../layout.pug
include ../mixins.pug

block content
    +greeting()
    +artistMessage(artist, "support")
    if interval === 'MONTH'
      p= t("emails.artistSubscriptionReceipt.thanksMonthly", { artistName: artist.name, tierName: artistUserSubscription.artistSubscriptionTier.name })
    else
      p= t("emails.artistSubscriptionReceipt.thanksYearly", { artistName: artist.name, tierName: artistUserSubscription.artistSubscriptionTier.name })
    table 
      tr 
        td #{artist.name}
        td.pa3 #{formatMoney(artistUserSubscription.amount, artist.user.currency || "usd")}
    p= t("emails.artistSubscriptionReceipt.viewSubscriptions")
    
    p= t("emails.artistSubscriptionReceipt.thankYou")
