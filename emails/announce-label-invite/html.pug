extends ../layout.pug
include ../mixins.pug

block content
  +greeting(user && user.name)
  if label && label.name
    p!= tHtml("emails.announceLabelInvite.invited", { labelName: label.name, instanceName })
  else
    p!= tHtml("emails.announceLabelInvite.invitedUnnamed", { instanceName })
  p #{t("emails.announceLabelInvite.acceptHere")} 
    a(href!=`${client}/manage/${artist && artist.id ? artist.id : ''}/customize`)= t("emails.announceLabelInvite.accept")
  p 
    a(href!=`${client}/${label && (label.urlSlug || label.id) ? label.urlSlug || label.id : ''}`)
      if label && label.name
        = t("emails.announceLabelInvite.viewLabel", { labelName: label.name, instanceName })
      else
        = t("emails.announceLabelInvite.viewUnnamedLabel", { instanceName })
