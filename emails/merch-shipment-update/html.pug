extends ../layout.pug
include ../mixins.pug

block content
  +greeting(buyerName)
  if quantity > 1
    p!= tHtml("emails.merchShipmentUpdate.updateWithQuantity", { merchTitle, quantity, artistUrl: `${client}/${artistUrlSlug}`, artistName })
  else
    p!= tHtml("emails.merchShipmentUpdate.update", { merchTitle, artistUrl: `${client}/${artistUrlSlug}`, artistName })
  p
    | #{t("emails.common.fulfillmentStatusLabel")}
    |
    strong
      +fulfillmentStatus(fulfillmentStatus)
  if trackingNumber
    p!= tHtml("emails.merchShipmentUpdate.trackingNumber", { trackingNumber })
  if trackingUrl
    p!= tHtml("emails.merchShipmentUpdate.trackShipment", { trackingUrl, trackingWebsite })
  p!= tHtml("emails.merchShipmentUpdate.seePurchases", { url: `${client}/profile/purchases`, instanceName })
  p= t("emails.merchShipmentUpdate.contactArtist")
