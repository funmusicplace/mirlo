extends ../layout.pug

block content
  if fundraiserName
    p= t("emails.chargeFailure.pledgeFailed", { amount: formatMoney(amount, currency), artistName, fundraiserName })
  else
    p= t("emails.chargeFailure.subscriptionFailed", { amount: formatMoney(amount, currency), artistName, tierName })

  p!= tHtml("emails.chargeFailure.completePayment", { url: `${client}/profile/billing?${urlParams}`, instanceName })
  hr
  p= t("emails.chargeFailure.thanks", { instanceName })
