extends ../layout.pug
include ../mixins.pug

block content
    .pa4= t("emails.reportAlbumProblem.reported", { email })
    .pa4 
      | #{reason}: #{description}
    .pa4 
      | trackgroupId: #{trackGroupId}
    if trackGroup
      .pa4= t("emails.reportAlbumProblem.trackGroup", { title: trackGroup.title, artistName: trackGroup.artist.name })
      .pa4= t("emails.reportAlbumProblem.viewHere")
      .pa4
        +releaseLink(trackGroup) #{trackGroup.title}
