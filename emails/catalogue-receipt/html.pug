extends ../layout.pug
include ../mixins.pug

block content
  p= t("emails.catalogueReceipt.intro", { artistName: artist.name })
  table
    thead
      tr
        th= t("emails.catalogueReceipt.title")
        th= t("emails.catalogueReceipt.downloadHeader")
    tbody
      each trackGroup in trackGroups
        tr
          td #{trackGroup.title}
          td
            +releaseLink(trackGroup, `/download?token=${trackGroup.token}&email=${encodeURIComponent(email)}`)= t("emails.catalogueReceipt.download")

  +supportArtist(artist, client, hasSubscriptionTiers)
  +setPasswordPrompt(email)
  +artistMessage(artist, "purchase")
    p= t("emails.common.enjoy")
