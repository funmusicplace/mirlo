extends ../layout.pug
include ../mixins.pug

block content
  p
    | You bought #{artist.name} entire digital catalogue!
    | This includes digital downloads of:
  table
    thead
      tr
        th Title
        th Download
    tbody
      each trackGroup in trackGroups
        tr
          td #{trackGroup.title}
          td
            a(href!=`${client}/${trackGroup.artist.urlSlug}/release/${trackGroup.urlSlug}/download?token=${trackGroup.token}&email=${encodeURIComponent(email)}`) download

  +supportArtist(artist, client, hasSubscriptionTiers)
  p
    | If you want to have access to all your purchases for this e-mail address,
    | simply
    |
    a(href!=`${client}/password-reset?email=${encodeURIComponent(email)}`) set a password for it
    | .
  - const purchaseMessage = artist?.properties?.emails?.purchase
  if purchaseMessage
    div!= purchaseMessage
  else
    p Enjoy!
