extends ../layout.pug
include ../mixins.pug

block content
    +greeting()
    if cancelledByArtist
      p= t("emails.artistSubscriptionCancelled.cancelledByArtist", { artistName: artist.name, instanceName })
    else
      p= t("emails.artistSubscriptionCancelled.cancelled", { artistName: artist.name, instanceName })
    if endsAt
      p= t("emails.artistSubscriptionCancelled.accessUntil", { date: formatDate(endsAt) })
    p!= tHtml("emails.artistSubscriptionCancelled.subscribeAgain", { url: client })
    if cancelledByArtist
      p= t("emails.artistSubscriptionCancelled.questionsForArtist", { artistName: artist.name })
    else
      p= t("emails.artistSubscriptionCancelled.didNotRequest")
