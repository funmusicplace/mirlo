extends ../layout.pug
include ../mixins.pug

block content
  if trackGroup
    p= t("emails.fundraiserSuccess.fundedRelease", { artistName: artist.name, title: trackGroup.title })
  else
    p= t("emails.fundraiserSuccess.funded", { artistName: artist.name, fundraiserName })

  p= t("emails.fundraiserSuccess.contributed", { amount: formatMoney(pledgedAmount, currency), goal: formatMoney(fundraisingGoal, currency) })
  p
    a(href!=fundraiserUrl)= t("emails.fundraiserSuccess.viewIt", { instanceName })
  hr
  p= t("emails.fundraiserSuccess.thanks", { instanceName })
