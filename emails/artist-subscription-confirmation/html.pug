extends ../layout.pug
include ../mixins.pug

block content
    +greeting()
    p= t("emails.artistSubscriptionConfirmation.intro", { artistName: artist.name, instanceName })
    p 
      a(href!=`${host}/v1/artists/${artist.id}/confirmFollow?email=${encodeURIComponent(email)}&token=${token}`)= t("emails.artistSubscriptionConfirmation.confirm")
    p 
      | #{t("emails.common.ignore")} 
      | !{tHtml("emails.artistSubscriptionConfirmation.contactInfo", { url: "https://mirlo.space" })}
