extends ../layout.pug
include ../mixins.pug

block content
  +greeting(userSubscriptions[0].user.name)
  p= t("emails.announceMonthlyReceipts.thanks")
  p= t("emails.announceMonthlyReceipts.meansALot")
  p= t("emails.announceMonthlyReceipts.supporting")
  table
    thead
      tr
        th= t("emails.announceMonthlyReceipts.artist")
        th.num= t("emails.announceMonthlyReceipts.amount")
    tbody
      each val in userSubscriptions
        tr
          td #{val.artistSubscriptionTier.artist.name}
          td.num #{formatMoney(val.amount, val.currency || val.artistSubscriptionTier.artist.user.currency || "usd")}

  p= t("emails.announceMonthlyReceipts.loveToSeeIt")
  p= t("emails.common.enjoy")
