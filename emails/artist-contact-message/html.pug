extends ../layout.pug

block content
    p= t("emails.artistContactMessage.hello", { instanceName })
    p= t("emails.artistContactMessage.intro", { senderName: sender.name, senderEmail: sender.email, artistName: artist.name })
    blockquote(style="border-left: 3px solid #ccc; margin: 1rem 0; padding: 0.25rem 1rem;")
      each line, i in message.split("\n")
        if i > 0
          br
        span= line
    p= t("emails.artistContactMessage.replyDirectly", { senderName: sender.name })
    p!= tHtml("emails.artistContactMessage.alsoVisible", { notificationsUrl: `${client}/profile/notifications`, instanceName })
