extends ../layout.pug
include ../mixins.pug

block content
  - const renewalAmount = formatMoney(artistUserSubscription.amount, currency || artist.user.currency || "usd")
  +greeting()
  if renewalDate
    p= t("emails.subscriptionRenewalReminder.willRenew", { artistName: artist.name, tierName: artistUserSubscription.artistSubscriptionTier.name, renewalDate: formatDate(renewalDate) })
  else
    p= t("emails.subscriptionRenewalReminder.willRenewUnknownDate", { artistName: artist.name, tierName: artistUserSubscription.artistSubscriptionTier.name })

  table
    thead
      tr
        th= t("emails.subscriptionRenewalReminder.artist")
        th.num= t("emails.subscriptionRenewalReminder.renewal")
    tbody
      tr
        td #{artist.name}
        if interval === 'MONTH'
          td.num= t("emails.subscriptionRenewalReminder.amountPerMonth", { amount: renewalAmount })
        else
          td.num= t("emails.subscriptionRenewalReminder.amountPerYear", { amount: renewalAmount })

  p= t("emails.subscriptionRenewalReminder.changesIntro")
  ul
    li!= tHtml("emails.subscriptionRenewalReminder.modifyAmount", { url: `${client}/${artist.urlSlug}/support`, artistName: artist.name })
    li= t("emails.subscriptionRenewalReminder.cancel")

  p= t("emails.subscriptionRenewalReminder.thanks", { artistName: artist.name })

  +artistMessage(artist, "support")
    p= t("emails.common.enjoy")
