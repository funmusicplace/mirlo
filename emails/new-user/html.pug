extends ../layout.pug
include ../mixins.pug

block content
  +greeting()
  p= t("emails.newUser.signedUp", { instanceName })
  p #{user.email}
  p 
    a(href!=`${clientDomain}/email-confirmation?token=${user.emailConfirmationToken}&id=${user.id}&client=${client}&accountType=${accountType}&email=${encodeURIComponent(user.email)}`)= t("emails.newUser.confirm")
  p= t("emails.common.ignore")
