extends ../layout.pug
include ../mixins.pug

block content
    p= t("emails.artistMerchContactForm.hello", { instanceName })
    p= t("emails.artistMerchContactForm.intro")
    div 
      p= t("emails.artistMerchContactForm.purchaseId", { id: purchase.id })
      p= t("emails.artistMerchContactForm.supporter", { name: purchase.user.name, email: purchase.user.email })
      p= t("emails.artistMerchContactForm.item", { title: purchase.merch.title })
      p
        | #{t("emails.common.fulfillmentStatusLabel")}
        |
        +fulfillmentStatus(purchase.fulfillmentStatus)
      p
        em "#{message}"
    p= t("emails.artistMerchContactForm.respond", { email: purchase.user.email })
