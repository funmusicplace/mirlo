extends ../layout.pug
include ../mixins.pug

block content
  p= t("emails.automaticallyReceivedAlbum.yay")
  if trackGroup.title
    p= t("emails.automaticallyReceivedAlbum.receivedWithTitle", { artistName: artist.name, title: trackGroup.title })
  else
    p= t("emails.automaticallyReceivedAlbum.received", { artistName: artist.name })

  p
    +releaseLink(trackGroup)
      if trackGroup.title
        | #{trackGroup.title}
      else
        = t("emails.automaticallyReceivedAlbum.listen")

  p= t("emails.automaticallyReceivedAlbum.availableNow")
  p= t("emails.common.enjoy")
