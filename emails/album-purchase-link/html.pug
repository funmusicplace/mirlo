extends ../layout.pug
include ../mixins.pug

block content
    h2 #{trackGroup.title} 
    p!= tHtml("emails.albumPurchaseLink.byArtist", { artistName: trackGroup.artist.name })
  
    +releaseLink(trackGroup)(style="background-color:#BE3455;color:#ffffff;padding:12px 24px;text-decoration:none;font-size:16px;border-radius:4px;display:inline-block;")= t("emails.albumPurchaseLink.buyNow")

    p!= tHtml("emails.albumPurchaseLink.support", { artistUrl: `${client}/${trackGroup.artist.urlSlug}`, artistName: trackGroup.artist.name, instanceName })
    p= t("emails.common.enjoy")
     
    p= t("emails.common.ignore")
