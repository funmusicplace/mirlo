extends ../layout.pug
include ../mixins.pug

block content
  +greeting()
  p= t("emails.oauthApprovalRequested.intro", { requestedBy, instanceName })
  p
    strong #{applicationName}
    br
    a(href=applicationUrl)= applicationUrl
  p= t("emails.oauthApprovalRequested.clientId", { clientId })
  p= t("emails.oauthApprovalRequested.approveOrBlock")
  p
    a(href=adminUrl)= adminUrl
