extends ../layout.pug
include ../mixins.pug

block content
    +greeting(userName)
    
    p= t("emails.artistDisabledNotification.disabled", { artistName, instanceName })
    
    if reason
        strong= t("emails.artistDisabledNotification.reason")
        != reason
    
    p
        strong= t("emails.artistDisabledNotification.whatThisMeans")
    ul
        li= t("emails.artistDisabledNotification.noSearch")
        li= t("emails.artistDisabledNotification.directUrlOnly")
        li= t("emails.artistDisabledNotification.noPurchases")
    
    if supportEmail
        p
            strong= t("emails.artistDisabledNotification.nextSteps")
        p!= tHtml("emails.artistDisabledNotification.appeal", { supportEmail })

        p= t("emails.artistDisabledNotification.review")
    
    p= t("emails.artistDisabledNotification.bestRegards")
    br
    | #{t("emails.artistDisabledNotification.signature")}
