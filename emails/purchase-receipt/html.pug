extends ../layout-wide.pug
include ../mixins.pug

mixin purchaseRow(title, transaction)
  tr
    td #{transaction.userFriendlyId || '---'}
    td #{title}
    +feeCells(transaction)

block content
  p= t("emails.purchaseReceipt.thanks")
  +artistMessage(artist, "purchase")(class="border pa3")
  - var receiptCurrency = transactions && transactions[0] && transactions[0].currency ? transactions[0].currency.toUpperCase() : ''
  table
    thead
      tr
        th= t("emails.purchaseReceipt.transactionId")
        th= t("emails.purchaseReceipt.item")
        if receiptCurrency
          th.num= t("emails.purchaseReceipt.amountWithCurrency", { currency: receiptCurrency })
        else
          th.num= t("emails.purchaseReceipt.amount")
        th.num= t("emails.purchaseReceipt.platformFee")
        th.num= t("emails.purchaseReceipt.paymentProcessorFee")
    tbody
      each transaction in transactions
        each purchase in transaction.trackGroupPurchases
          +purchaseRow(purchase.trackGroup.title, transaction)
          tr
            td(colspan="5")
              +releaseLink(purchase.trackGroup)= t("emails.purchaseReceipt.viewRelease")

        each purchase in transaction.trackPurchases
          +purchaseRow(purchase.track.title, transaction)
          tr
            td(colspan="5")
              +releaseLink(purchase.track.trackGroup)= t("emails.purchaseReceipt.viewRelease")

        each purchase in transaction.merchPurchases
          +purchaseRow(`${purchase.merch.title} ${purchase.options.map((o) => o.name).join(', ')}: ${purchase.quantity}`, transaction)
        each tip in transaction.tips
          +purchaseRow(t("emails.purchaseReceipt.tip"), transaction)

  p= t("emails.purchaseReceipt.community")
  hr
  +setPasswordPrompt(email)
    | #{t("emails.purchaseReceipt.newTo", { instanceName })}
