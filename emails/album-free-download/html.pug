extends ../layout.pug
include ../mixins.pug

block content
  p= t("emails.albumFreeDownload.woohoo")
  p!= tHtml("emails.albumFreeDownload.intro", { title: trackGroup.title, artistName: trackGroup.artist.name })

  table
    thead
      tr
        th= t("emails.albumFreeDownload.title")
        th= t("emails.albumFreeDownload.downloadHeader")
    tbody
      tr
        td #{trackGroup.title}
        td
          +releaseLink(trackGroup, `/download?token=${token}&email=${encodeURIComponent(email)}`)= t("emails.albumFreeDownload.download")

  +supportArtist(trackGroup.artist, client, hasSubscriptionTiers)
  p= t("emails.common.enjoy")
