extends ../layout.pug
include ../mixins.pug

block content
  p!= tHtml("emails.downloadReady.intro", { title: trackGroup.title, artistName: trackGroup.artist.name, format })
  table
    tr
      td #{trackGroup.title}
      td
        +releaseLink(trackGroup, "/download")= t("emails.downloadReady.download")

  p
  +supportArtist(trackGroup.artist, client, hasSubscriptionTiers)
  p= t("emails.common.enjoy")
