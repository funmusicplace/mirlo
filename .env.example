JWT_SECRET=test1234
REFRESH_TOKEN_SECRET=test1234

# Set to "production" on a deployed https instance: auth cookies become
# secure + strict (which breaks login over plain http — keep "development"
# for local dev), and unconfigured email is dropped instead of being caught
# by MailHog. scripts/generate-env.sh sets this based on the instance URL.
NODE_ENV=development

PORT=3000
API_DOMAIN='http://localhost:3000'
# Where the client is served: the Vite dev server in local dev, the same URL
# as API_DOMAIN on a deployed instance. Used for embedded widget URLs in posts
# and the OAuth consent pages.
CLIENT_DOMAIN='http://localhost:8080'

# NGINX_PORT=3001
MEDIA_LOCATION=./data/media/
TEMP_LOCATION=/tmp/data/media/

DATABASE_URL="postgresql://nomads:nomads@pgsql:5432/nomads?schema=public"
POSTGRES_LOCAL_MACHINE_PORT=5434
POSTGRES_PASSWORD=nomads
POSTGRES_USER=nomads

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=password

# Object storage: any S3-compatible service. Defaults to the bundled Garage
# store; drop COMPOSE_PROFILES when using an external one. Garage keys must be
# "GK" + 24 hex chars and a 64 hex char secret.
COMPOSE_PROFILES=garage
S3_ENDPOINT=http://garage:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=GK0e7a1c94b2df63805a7e4d12
S3_SECRET_ACCESS_KEY=5f3b9d20c8a7e146b0d94f27a3c5e8b16d20f74a9c3e581bd67a0f4923ce8d15
# Browser-facing endpoint for presigned URLs. Defaults to S3_ENDPOINT; empty
# sends uploads and downloads through the API.
S3_PUBLIC_ENDPOINT=http://localhost:9000
SERVE_IMAGES_FROM_API=true

MAILHOG_PORT=1025

CLOUDFLARE_TURNSTILE_API_SECRET=

TRANSIFEX_API_TOKEN=
TRANSIFEX_LANGUAGE_THRESHOLD=40
TRANSIFEX_ORGANIZATION=mirlo
TRANSIFEX_PROJECT=mirlo

STRIPE_KEY=
STRIPE_WEBHOOK_CONNECT_SIGNING_SECRET=

SCHEDULED_TASKS_ENABLED=
DATA_MIGRATIONS_ENABLED=
